# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE DRIVE STORAGE INTEGRATION (Admin 5 TB Quota)
# All media uploads (audio notes, ad videos, screenshots, doubts) route via Google Drive API v3
# Storage is deducted exclusively from the Admin's 5 TB drive quota.
# Admin service account key JSON or client credentials:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Dedicated Google Drive Folder ID in Admin's 5 TB drive (optional, auto-creates or defaults to root):
GOOGLE_DRIVE_FOLDER_ID=

# TRIO INC. 3-MEMBER WHITELIST (Comma-separated emails)
# Default includes Admin (sachinbarman20190@gmail.com) and two member slots
TRIO_ADMIN_EMAIL="sachinbarman20190@gmail.com"
TRIO_MEMBER_2_EMAIL="member2@triopod.com"
TRIO_MEMBER_3_EMAIL="member3@triopod.com"
